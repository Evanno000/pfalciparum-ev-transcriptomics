^DATABASE = GeoMiame
!Database_name = Gene Expression Omnibus (GEO)
!Database_institute = NCBI NLM NIH
!Database_web_link = http://www.ncbi.nlm.nih.gov/geo
!Database_email = geo@ncbi.nlm.nih.gov
^SERIES = GSE241277
!Series_title = RNAseq analysis of Plasmodium falciparum extracellular vesicles
!Series_geo_accession = GSE241277
!Series_status = Public on Aug 23 2023
!Series_submission_date = Aug 21 2023
!Series_last_update_date = Oct 26 2023
!Series_pubmed_id = 37833314
!Series_summary = Plasmodium falciparum secretes extracellular vesicles that contain RNA. The biological benefit of this secretion to the secreting parasite is not known. Here, we sequenced the RNA content of extracellular vesicles and compared with that of the secreting whole parasites. The data suggests that extracellular vesicles might be part of a post-transcriptional regulatory mechanism that shapes intracellular RNA levels in the parasite.
!Series_overall_design = To investigate the biological benefit of extracellular vesicles to the asexual blood stages of Plasmodium falciparum, we isolated the RNA content of extracellular vesicles obtained from six parasite isolates (at 4-hourly intervals) and compared with that of the whole parasite.
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Kioko,,Mwikali
!Series_contributor = Abdirahman,,Abdi
